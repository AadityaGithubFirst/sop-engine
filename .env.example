# ---------------------------------------------------------------------------
# SOP Engine - Local / Air-Gapped Configuration
# Copy to .env and adjust. No cloud API keys are ever required.
# ---------------------------------------------------------------------------

# Base URL of the local Ollama daemon.
OLLAMA_HOST=http://127.0.0.1:11434

# Primary reasoning model used by all agents.
# Recommended free models: deepseek-r1:8b | llama3.1:8b | qwen2.5:7b
MODEL_NAME=deepseek-r1:8b

# Optional lighter model for cheap/fast sub-tasks. Falls back to MODEL_NAME.
FAST_MODEL=llama3.1:8b

# Sampling controls for deterministic, audit-friendly documents.
TEMPERATURE=0.2
NUM_CTX=8192

# --- Multi-pass validation -------------------------------------------------
# Re-prompts allowed per pass when the structural gate rejects the output.
# After this budget, deterministic Python repair fills any remaining gap.
MAX_VALIDATION_RETRIES=2

# When true, a document that still fails the gate after repair is rejected
# (HTTP 422) rather than released in a defective state.
STRICT_VALIDATION=true

# Per-request timeout (seconds) when talking to Ollama.
REQUEST_TIMEOUT=600

# Directory where generated .docx artifacts are written.
OUTPUT_DIR=/tmp/sop_engine

# Public base URL used to build the download link returned by the API.
PUBLIC_BASE_URL=http://127.0.0.1:8000

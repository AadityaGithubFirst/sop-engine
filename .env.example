# ---------------------------------------------------------------------------
# SOP Engine - Local / Air-Gapped Configuration
# Copy to .env and adjust. No cloud API keys are ever required.
# ---------------------------------------------------------------------------

# Base URL of the local Ollama daemon.
OLLAMA_HOST=http://127.0.0.1:11434

# Primary reasoning model used by all agents.
# Recommended free models: deepseek-r1:8b | llama3.1:8b | qwen2.5:7b
MODEL_NAME=deepseek-r1:8b

# Optional lighter model for cheap/fast sub-tasks. Falls back to MODEL_NAME.
FAST_MODEL=llama3.1:8b

# Sampling controls for deterministic, audit-friendly documents.
TEMPERATURE=0.2
NUM_CTX=8192

# Reasoning models (deepseek-r1, qwen3, ...) emit a long internal monologue
# before the answer. On a fixed context window that monologue truncates the
# actual document section, so thinking is OFF by default: every pass answers
# directly. Turn on only if you have also raised NUM_CTX to hold both.
ENABLE_THINKING=false

# Scale the context window to the model's size (8B->8192, 14B->16384,
# 32B->24576, 70B+->32768), never below NUM_CTX, never above NUM_CTX_CAP.
# This is what lets a "better" (larger) model finish a section instead of
# running out of budget. Set AUTO_NUM_CTX=false to pin every model to NUM_CTX.
AUTO_NUM_CTX=true
NUM_CTX_CAP=32768

# --- Multi-pass validation -------------------------------------------------
# Re-prompts allowed per pass when the structural gate rejects the output.
# After this budget, deterministic Python repair fills any remaining gap.
MAX_VALIDATION_RETRIES=2

# When true, a document that still fails the gate after repair is rejected
# (HTTP 422) rather than released in a defective state.
STRICT_VALIDATION=true

# Per-request timeout (seconds) when talking to Ollama. Deliberately generous
# because a large model on CPU can spend several minutes on one section.
REQUEST_TIMEOUT=900

# Scale the per-call timeout to the model's size (14B gets 2x, 32B gets 3x,
# 70B+ gets 4x the base). Stops large models being cut off mid-answer.
AUTO_TIMEOUT=true
REQUEST_TIMEOUT_CAP=3600

# Directory where generated .docx artifacts are saved permanently.
# Defaults to ~/Documents/SOP Builder so documents survive temp-folder cleanup.
# Change this to any folder you like; it is created automatically.
OUTPUT_DIR=

# Public base URL used to build the download link returned by the API.
PUBLIC_BASE_URL=http://127.0.0.1:8000
